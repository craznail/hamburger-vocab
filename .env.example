# Active provider: azure or aliyun
VITE_TTS_PROVIDER=azure

# Azure AI Speech
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=eastus
VITE_AZURE_SPEECH_VOICE=en-US-JennyNeural
